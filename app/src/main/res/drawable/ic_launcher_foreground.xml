                <item android:offset="0.0" android:color="#38BDF8" />
                <item android:offset="1.0" android:color="#0284C7" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Keyhole -->
    <path
        android:pathData="M54,67m-2.8,0a2.8,2.8 0,1 1,5.6 0a2.8,2.8 0,1 1,-5.6 0"
